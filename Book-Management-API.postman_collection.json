{
  "info": {
    "name": "Book Management API",
    "description": "API collection for Phase 9 QA Testing",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authors",
      "item": [
        {
          "name": "Get All Authors",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/authors",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "authors"
              ]
            }
          }
        },
        {
          "name": "Create Author",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"J.K. Rowling\",\n  \"birthYear\": 1965,\n  \"bio\": \"British author\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/authors",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "authors"
              ]
            }
          }
        },
        {
          "name": "Update Author",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bio\": \"Updated bio for author\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/authors/<REPLACE_AUTHOR_ID>",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "authors",
                "<REPLACE_AUTHOR_ID>"
              ]
            }
          }
        },
        {
          "name": "Delete Author",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/authors/<REPLACE_AUTHOR_ID>",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "authors",
                "<REPLACE_AUTHOR_ID>"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Books",
      "item": [
        {
          "name": "Get All Books",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ]
            }
          }
        },
        {
          "name": "Get Book By ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/books/<REPLACE_BOOK_ID>",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books",
                "<REPLACE_BOOK_ID>"
              ]
            }
          }
        },
        {
          "name": "Create Book",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Harry Potter\",\n  \"price\": 120,\n  \"genre\": \"Fantasy\",\n  \"publishedYear\": 1997,\n  \"author\": \"<REPLACE_AUTHOR_ID>\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ]
            }
          }
        },
        {
          "name": "Update Book",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 150\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/books/<REPLACE_BOOK_ID>",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books",
                "<REPLACE_BOOK_ID>"
              ]
            }
          }
        },
        {
          "name": "Delete Book",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/books/<REPLACE_BOOK_ID>",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books",
                "<REPLACE_BOOK_ID>"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Query Tests",
      "item": [
        {
          "name": "Books Pagination",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/books?page=1&limit=2",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "2"
                }
              ]
            }
          }
        },
        {
          "name": "Books Genre Filter",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/books?genre=Fantasy",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ],
              "query": [
                {
                  "key": "genre",
                  "value": "Fantasy"
                }
              ]
            }
          }
        },
        {
          "name": "Books Title Search",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/books?search=harry",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "harry"
                }
              ]
            }
          }
        },
        {
          "name": "Books Combined Query",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/books?genre=Fantasy&search=harry&page=1&limit=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ],
              "query": [
                {
                  "key": "genre",
                  "value": "Fantasy"
                },
                {
                  "key": "search",
                  "value": "harry"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            }
          }
        },
        {
          "name": "Authors Pagination",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/authors?page=1&limit=2",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "authors"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "2"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. Error Tests",
      "item": [
        {
          "name": "Invalid ObjectId",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/books/this-is-not-an-id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books",
                "this-is-not-an-id"
              ]
            }
          }
        },
        {
          "name": "Missing Required Field",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ]
            }
          }
        },
        {
          "name": "Non-existing Resource",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/books/5f8d0d55b54764421b7156d9",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books",
                "5f8d0d55b54764421b7156d9"
              ]
            }
          }
        },
        {
          "name": "Invalid Year",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Future Book\",\n  \"publishedYear\": 3000,\n  \"author\": \"<REPLACE_AUTHOR_ID>\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ]
            }
          }
        },
        {
          "name": "Negative Price",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Negative Price Book\",\n  \"price\": -50,\n  \"author\": \"<REPLACE_AUTHOR_ID>\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ]
            }
          }
        },
        {
          "name": "Non-existing Author",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Ghost Book\",\n  \"author\": \"5f8d0d55b54764421b7156d9\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ]
            }
          }
        },
        {
          "name": "Referenced Author Deletion",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/authors/<REPLACE_AUTHOR_ID_WITH_BOOKS>",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "authors",
                "<REPLACE_AUTHOR_ID_WITH_BOOKS>"
              ]
            }
          }
        },
        {
          "name": "Invalid Pagination",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/books?limit=999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "999"
                }
              ]
            }
          }
        },
        {
          "name": "Undefined Route",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/random-route",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "random-route"
              ]
            }
          }
        }
      ]
    }
  ]
}
